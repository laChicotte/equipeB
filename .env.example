DATABASE_URL=postgresql://talentlink:development@127.0.0.1:5432/talentlink
DB_DRIVER=postgres
APP_URL=http://127.0.0.1:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_ENABLED=false
AUTH_REGISTRATION_ENABLED=false
REAL_ACCOUNTS_APPROVED=false
MAIL_DRIVER=file
MAIL_FROM=TalentLink <no-reply@example.invalid>
SMTP_URL=
MESSAGING_RESEND_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
MINOR_PRIVATE_FEATURES_ENABLED=false
MENTORING_ENABLED=false
PLAY_ENABLED=false
MESSAGING_ENABLED=false
PRIVATE_COMMUNICATIONS_APPROVED=false

# Séances et objectifs privés, fermés par défaut
PLANNING_ENABLED=false

# Émission réelle des attestations soumise à validation distincte
ATTESTATIONS_ENABLED=false
ATTESTATIONS_APPROVED=false

# Phase publique découverte et entretien (fermés par défaut)
NEXT_PUBLIC_SITE_PHASE=private
MAINTENANCE_ENABLED=false
CRON_SECRET=

# Validation distincte avant toute inscription adulte en production
ADULT_REGISTRATION_APPROVED=false

# Espaces apprentissage, fermés par défaut hors prototype
LEARNING_ENABLED=false
PROTOTYPE_MODE=false

# Fichiers privés Neon, secrets côté serveur uniquement
ASSETS_ENABLED=false
FILES_ENDPOINT=
FILES_REGION=us-east-2
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=

# Sprint généré par IA : 3 demandes/compte/jour, 30/jour au total (UTC)
AI_SPRINT_ENABLED=false
AI_GATEWAY_MODEL=
# Local uniquement ; Vercel utilise son identité OIDC. Ne pas publier cette clé.
AI_GATEWAY_API_KEY=
