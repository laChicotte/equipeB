{
  "name": "talentlink",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1",
    "preview:vitrine": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs tests/*.test.ts",
    "db:check": "node scripts/database.ts check",
    "db:migrate": "node scripts/database.ts migrate",
    "db:smoke": "node scripts/native-smoke.ts",
    "db:smoke-mentoring": "node scripts/mentoring-smoke.ts",
    "test:e2e": "node scripts/e2e.ts",
    "deploy:check": "node scripts/deployment.ts preview",
    "deploy:check-accounts": "node scripts/deployment.ts accounts",
    "mail:check": "node scripts/deployment.ts smtp",
    "test:preview": "node scripts/preview-check.ts",
    "play:demo": "node scripts/play-demo.ts",
    "play:purge": "node scripts/play-retention.ts",
    "db:smoke-play": "node scripts/play-smoke.ts",
    "db:smoke-messaging": "node scripts/messaging-smoke.ts",
    "messaging:demo": "node scripts/messaging-demo.ts",
    "db:smoke-planning": "node scripts/planning-smoke.ts",
    "planning:demo": "node scripts/planning-demo.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "nodemailer": "10.3.1",
    "@electric-sql/pglite": "0.5.15",
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.0",
    "@types/nodemailer": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
